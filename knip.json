{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "glab"
  ],
  "ignoreDependencies": [
    "react-devtools-core",
    "@semantic-release/github",
    "@semantic-release/npm",
    "@semantic-release/release-notes-generator",
    "@earendil-works/pi-coding-agent"
  ],
  "ignoreUnresolved": [
    "packages/workit-cli/scripts/build.ts",
    "packages/workit-opencode/scripts/build.ts",
    "packages/workit-cursor/scripts/build.ts",
    "packages/workit-codex/scripts/build.ts",
    "packages/workit-pi/scripts/build.ts",
    "packages/workit-mcp/scripts/build.ts"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/workit-core": {
      "entry": [
        "src/core.ts",
        "src/core/*.ts",
        "scripts/doctor-check.ts",
        "scripts/rewrite-workspace-deps.ts",
        "scripts/sync-release-manifests.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/workit-cli": {
      "entry": ["src/index.tsx", "src/*.ts", "src/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreUnresolved": ["scripts/build.ts"],
      "ignoreDependencies": ["@brainervirus/workit-cursor", "@brainervirus/workit-opencode"]
    },
    "packages/workit-opencode": {
      "entry": ["src/plugin.ts", "src/tools/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreUnresolved": ["scripts/build.ts"]
    },
    "packages/workit-cursor": {
      "entry": ["hooks/workit-hook.ts", "hooks/session-start.ts", "mcp/*.ts"],
      "project": ["hooks/**/*.ts", "mcp/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/workit-codex": {
      "entry": ["hooks/workit-hook.ts"],
      "project": ["hooks/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/workit-pi": {
      "entry": ["src/tools.ts", "src/context.ts", "extensions/workit.ts", "scripts/build.ts"],
      "project": ["src/**/*.ts", "extensions/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["@brainervirus/workit-core"]
    },
    "packages/workit-mcp": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
