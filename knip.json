{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "ignoreBinaries": ["glab", "workit-cursor-session-start"],
  "ignoreDependencies": [
    "@semantic-release/github",
    "@semantic-release/npm",
    "@semantic-release/release-notes-generator",
    "conventional-changelog-conventionalcommits",
    "@earendil-works/pi-coding-agent"
  ],
  "ignoreUnresolved": [
    "packages/workit-cli/scripts/build.ts",
    "packages/workit-opencode/scripts/build.ts",
    "packages/workit-cursor/scripts/build.ts",
    "packages/workit-codex/scripts/build.ts",
    "packages/workit-pi/scripts/build.ts",
    "packages/workit-mcp/scripts/build.ts",
    "packages/workit-claude-code/scripts/build.ts"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!", "test/**/*.test.{ts,tsx}", "test/opencode-v2/mock-provider.ts"],
      "project": ["scripts/**/*.ts!", "test/**/*.{ts,tsx}"]
    },
    "packages/workit-core": {
      "entry": ["scripts/*.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!"]
    },
    "packages/workit-cli": {
      "entry": ["src/main.ts!", "scripts/build.ts!", "scripts/doctor-check.ts!"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts!"],
      "ignoreDependencies": ["@brainervirus/workit-cursor", "@brainervirus/workit-opencode"],
      "ignoreUnresolved": ["scripts/build.ts"]
    },
    "packages/workit-opencode": {
      "entry": ["src/index.ts!", "index.ts!", "scripts/build.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!"],
      "ignoreUnresolved": ["scripts/build.ts"]
    },
    "packages/workit-cursor": {
      "entry": [
        "hooks/workit-hook.ts!",
        "hooks/session-start.ts!",
        "mcp/run-server.ts!",
        "scripts/build.ts!"
      ],
      "project": ["hooks/**/*.ts!", "mcp/**/*.ts!", "scripts/**/*.ts!"]
    },
    "packages/workit-codex": {
      "entry": ["hooks/workit-hook.ts!", "scripts/launch-mcp.ts!", "scripts/build.ts!"],
      "project": ["hooks/**/*.ts!", "scripts/**/*.ts!"]
    },
    "packages/workit-pi": {
      "entry": ["extensions/workit.ts!", "src/worker.ts!", "scripts/build.ts!"],
      "project": ["src/**/*.ts!", "extensions/**/*.ts!", "scripts/**/*.ts!"],
      "ignoreDependencies": ["@brainervirus/workit-core"]
    },
    "packages/workit-claude-code": {
      "entry": ["src/hook.ts!", "src/run.ts!", "scripts/build.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!"],
      "ignoreDependencies": ["@brainervirus/workit-cli"]
    },
    "packages/workit-mcp": {
      "entry": ["scripts/build.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!"]
    }
  }
}
