{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "jsx": "react-jsx"
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "packages/workit-core/src/**/*.ts",
    "packages/workit-opencode/src/**/*.ts",
    "packages/workit-cli/src/**/*.tsx",
    "packages/workit-cursor/mcp/**/*.ts"
  ]
}
