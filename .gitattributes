* text=auto eol=lf

# Generated copies (test/workit-core/generated-copies.test.ts): review lanes
# (#333) count them as no review, and the forge collapses them in diffs.
packages/workit-cursor/skills/** linguist-generated
packages/workit-cursor/commands/** linguist-generated
packages/workit-cli/assets/templates/** linguist-generated
CHANGELOG.md merge=workit-changelog

# Byte-compared fixtures keep LF on every OS even if the default above changes
# (#415): test/workit-core/gitattributes.test.ts fails on a committed fixture,
# golden or snapshot that resolves to neither eol=lf nor -text.
**/fixtures/** text=auto eol=lf
**/testdata/** text=auto eol=lf
*.golden text=auto eol=lf
*.snap text=auto eol=lf
