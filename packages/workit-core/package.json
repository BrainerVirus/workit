{
  "name": "@brainervirus/workit-core",
  "version": "1.2.1",
  "private": false,
  "description": "Workit shared core — task, policy, evidence, review, decision, worker, and writer state for agentic coding workflows",
  "keywords": [
    "agentic-coding",
    "ai-agents",
    "codex",
    "cursor",
    "mcp",
    "opencode",
    "pi",
    "policy-engine",
    "task-management",
    "typescript",
    "workflow"
  ],
  "homepage": "https://github.com/BrainerVirus/workit#readme",
  "bugs": {
    "url": "https://github.com/BrainerVirus/workit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrainerVirus/workit.git"
  },
  "files": [
    "src/",
    "scripts/",
    "skills/",
    "templates/",
    "README.md",
    "LICENSE",
    "!scripts/verify-project.sh"
  ],
  "type": "module",
  "main": "./src/core.ts",
  "exports": {
    "./src/*.ts": "./src/*.ts",
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.8.1",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
